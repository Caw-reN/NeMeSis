[mysqld]
# General
default_authentication_plugin=mysql_native_password
skip-host-cache
skip-name-resolve

# Character Set
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

# Performance
innodb_buffer_pool_size=256M
innodb_log_file_size=64M
max_connections=200

[client]
default-character-set=utf8mb4
