# NMS Go Worker — Environment Configuration
# Copy this file to .env and adjust values accordingly.

# -----------------------------------------------
# Database (must match docker-compose.yml values)
# -----------------------------------------------
DB_HOST=database
DB_PORT=3306
DB_NAME=nms_db
DB_USER=nms_user
DB_PASSWORD=secret

# -----------------------------------------------
# Worker Behavior
# -----------------------------------------------
# How often (seconds) to poll all devices. Min: 30
POLL_INTERVAL_SECONDS=60

# Max concurrent scan goroutines (adjust based on host RAM)
WORKER_POOL_SIZE=50
